    {
      "parameters": {
        "jsCode": "const resumen = {};\n\nfor (const item of $input.all()) {\n  const cuenta = String(item.json.cuenta_contable);\n  const nombre = item.json.nombre_cuenta;\n  const importe = Number(item.json.importe ?? 0);\n\n  if (!resumen[cuenta]) {\n    resumen[cuenta] = {\n      cuenta_contable: cuenta,\n      nombre_cuenta: nombre,\n      importe_total: 0,\n    };\n  }\n\n  resumen[cuenta].importe_total += importe;\n}\n\nreturn Object.values(resumen).map((fila) => ({\n  json: {\n    ...fila,\n    importe_total: Number(fila.importe_total.toFixed(2)),\n  },\n}));"
      },
