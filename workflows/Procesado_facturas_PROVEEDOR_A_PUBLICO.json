      "id": "87ff0025-debb-422d-a7de-9ef2233b7eda",
      "name": "Extraer datos factura"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.output?.[0]?.content?.[0]?.text;\n\nif (!raw) {\n  throw new Error('No se encontró la respuesta del modelo');\n}\n\nconst cleaned = raw\n  .replace(/^```json\\s*/i, '')\n  .replace(/```$/i, '')\n  .trim();\n\nconst data = JSON.parse(cleaned);\n\n// Aseguramos que articulos sea un array\nif (!Array.isArray(data.articulos)) {\n  data.articulos = [];\n}\n\nconst extras = [\n  {\n    campo: 'ibee',\n    codigo: 'IBEE',\n    descripcion: 'IBEE',\n  },\n  {\n    campo: 'punto_verde',\n    codigo: 'PUNT_VERD',\n    descripcion: 'PUNT VERD',\n  },\n  {\n    campo: 'radial',\n    codigo: 'RADIAL',\n    descripcion: 'RADIAL',\n  },\n];\n\nfor (const extra of extras) {\n  const importe = Number(data[extra.campo] ?? 0);\n\n  const yaExiste = data.articulos.some(\n    articulo => articulo.codigo_articulo === extra.codigo\n  );\n\n  if (importe > 0 && !yaExiste) {\n    data.articulos.push({\n      codigo_articulo: extra.codigo,\n      descripcion: extra.descripcion,\n      albaran: '—',\n      cajas: null,\n      cantidad: null,\n      precio: null,\n      importe_descuento: null,\n      importe: importe,\n      iva_porcentaje: 21,\n    });\n  }\n}\n\ndelete data.ibee;\ndelete data.punto_verde;\ndelete data.radial;\n\nreturn {\n  json: data,\n};"
      },
